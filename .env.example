# JWT signing secret, separate from Supabase keys. Keep the generated value in ignored .env.
JWT_SECRET=

# Optional: persist runs to Supabase. Leave blank to keep everything in memory.
# Use the service_role key (Project Settings -> API). Never expose it to the frontend.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
